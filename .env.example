# Copy to .env (gitignored) and fill in.
# Used by:  uv run --env-file .env src/server.py   and   docker run --env-file .env ...
# Comments must stay on their own lines: docker --env-file does not support inline comments.
OPENAI_API_KEY=
# Optional: only used when LLM_PROVIDER=gemini (AgentBeats scenarios use this name for the Gemini key)
GOOGLE_API_KEY=
# Optional overrides; empty = built-in defaults (openai / gpt-5.4-mini, gemini / gemini-3.8-flash)
LLM_PROVIDER=
LLM_MODEL=
# Optional Pi-Bench knobs (defaults shown); see README 'Pi-Bench path'
# Reasoning effort default is model-aware: none for the gpt-5.4 family (which rejects any other
# value together with tools on chat completions), medium otherwise.
#PIBENCH_REASONING_EFFORT=
#PIBENCH_MAX_STEPS=40
#PIBENCH_NUDGE_STEP_MARGIN=4
#PIBENCH_TURN_BUDGET_S=95
#PIBENCH_LLM_TIMEOUT_S=80
#PIBENCH_LLM_MAX_RETRIES=2
#PIBENCH_MAX_OUTPUT_TOKENS=24000
#PIBENCH_SEND_SEED=0
#PIBENCH_STRIP_TOOL_CONTENT=0
#PIBENCH_NUDGE_AFTER_USER_TURNS=7
